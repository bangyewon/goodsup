#!/bin/sh
# 최초 1회 다음 명령으로 활성화하세요:
#   chmod +x .githooks/pre-commit
#   git config core.hooksPath .githooks
#
# 커밋 전 테스트를 로컬에서 먼저 강제합니다. AI가 생성한 코드든 직접 작성한 코드든
# 예외 없이 이 게이트를 통과해야 커밋됩니다 (CLAUDE.md 테스트 규칙과 동일 기준).
# 백엔드 프로젝트가 back/ 디렉터리에 있으므로 그 안에서 gradlew를 실행합니다.

echo "▶ 커밋 전 테스트 실행 중..."

(cd back && ./gradlew test --quiet)

if [ $? -ne 0 ]; then
  echo ""
  echo "✗ 테스트 실패로 커밋이 중단되었습니다."
  echo "  테스트를 통과한 뒤 다시 커밋해주세요."
  exit 1
fi

echo "✓ 테스트 통과. 커밋을 진행합니다."
exit 0
